{
  "env": {
    "react-native/react-native": true,
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended",
    "plugin:react-native/all"
  ],
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true
    },
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "plugins": [
    "react",
    "react-native"
  ],
  "rules": {
    "react/prop-types": 0,
    "react/display-name": 0,
    "react-native/no-raw-text": 0,
    "no-console": 1,
    "semi": [2, "always"],
    "comma-dangle": [2, "always-multiline"],
    "quotes": [2, "single"],
    "indent": [2, 2]
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  }
}
